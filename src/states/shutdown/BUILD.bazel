load("//bzl:defs.bzl", "samwise_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "shutdown_state",
    srcs = ["shutdown_state.c"],
    hdrs = ["shutdown_state.h"],
    includes = ["."],
    deps = [
        "//src/common",
        "//src/slate",
        "//src/scheduler:state_machine",
        "//src/scheduler:state_ids",
        "//src/tasks/watchdog:watchdog_task",
        "//src/tasks/shutdown_listen:shutdown_listen_task",
    ] + select({
        "//bzl:test_mode": [
            "//src/drivers/flash:flash_mock",
            "//src/drivers/logger:logger_mock",
            "//src/drivers/neopixel:neopixel_mock",
            "//src/test_mocks:pico_stdlib_mock",
        ],
        "//conditions:default": [
            "//src/drivers/flash",
            "//src/drivers/logger",
            "//src/drivers/neopixel",
            "@pico-sdk//src/rp2_common/pico_stdlib:pico_stdlib",
        ],
    }),
)

samwise_test(
    name = "shutdown_state_test",
    srcs = ["test/test_shutdown_state.c"],
    deps = [
        ":shutdown_state",
        "//src/drivers/flash",
    ],
)
