package(default_visibility = ["//visibility:public"])

# Exported so the OTA hardware test can compile the real task against its own
# filesystem stubs instead of linking the littlefs-backed implementation.
exports_files([
    "ota_device.h",
    "ota_task.c",
    "ota_task.h",
])

cc_library(
    name = "ota_task",
    srcs = ["ota_task.c"],
    hdrs = [
        "ota_device.h",
        "ota_task.h",
    ],
    includes = ["."],
    deps = [
        "//src/common",
        "//src/slate",
        "//src/scheduler:state_machine",
        "//src/filesys",
        "//src/packet",
        "//src/tasks/radio:radio_task",
        "//src/utils",
    ] + select({
        "//bzl:test_mode": [
            "//src/drivers/logger:logger_mock",
            "//src/drivers/rfm9x:rfm9x_mock",
            "//src/drivers/watchdog:watchdog_mock",
            "//src/test_mocks:hardware_flash_mock",
            "//src/test_mocks:hardware_sync_mock",
            "//src/test_mocks:pico_bootrom_mock",
            "//src/test_mocks:pico_stdlib_mock",
            "//src/test_mocks:pico_util_mock",
        ],
        "//conditions:default": [
            "//src/drivers/logger",
            "//src/drivers/rfm9x",
            "@pico-sdk//src/rp2_common/pico_stdlib:pico_stdlib",
            "@pico-sdk//src/rp2_common/hardware_flash:hardware_flash",
            "@pico-sdk//src/rp2_common/hardware_sync:hardware_sync",
            "@pico-sdk//src/rp2_common/pico_bootrom:pico_bootrom",
        ],
    }),
)
